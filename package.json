  },
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "bootstrap": "5.3.3",
    "flickity": "2.3.0",
